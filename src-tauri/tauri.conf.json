{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Perfect Text",
  "version": "0.3.0",
  "build": {
    "beforeDevCommand": "npx vite",
    "beforeBuildCommand": "npx vite build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Perfect Text",
        "label": "main",
        "width": 480,
        "height": 700,
        "resizable": true,
        "center": true,
        "minWidth": 380,
        "minHeight": 550,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self' data:; connect-src 'self' https://*.supabase.co https://fonts.googleapis.com https://fonts.gstatic.com wss://stt-rt.soniox.com https://raw.githubusercontent.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com data:; font-src https://fonts.gstatic.com; media-src 'self' blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' data:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false,
        "languages": [
          "English",
          "Slovenian"
        ],
        "installerIcon": "icons/icon.ico",
        "headerImage": null,
        "sidebarImage": null,
        "installerHooks": "nsis/installer.nsi"
      }
    },
    "shortDescription": "Perfect Text — AI Speech-to-Text",
    "longDescription": "Desktop aplikacija za transkripcijo govora v besedilo. Deluje kjerkoli na Windows računalniku."
  },
  "identifier": "si.tipkam.desktop",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "perfecttext"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBQTc5Q0M5OTQ5NzVDRjUKUldUMVhKZVV5WnlubWd3Sm5FTE1RNWNVcDBTU0N4VzJGR1ArVTdBeDVpUU1wRDdoNGVSTTJwem0K",
      "endpoints": [
        "https://raw.githubusercontent.com/andrej99ai/tipkam-si-desktop/main/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
